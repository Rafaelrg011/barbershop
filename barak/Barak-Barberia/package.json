{
  "name": "barak-barberia",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/device-access.test.cjs tests/operator.test.mjs tests/functions.test.mjs tests/bridge.test.cjs tests/accounts.test.mjs tests/security.test.cjs tests/salary-tips.test.cjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-barbe-shop \"node --test tests/firestore-rules.test.mjs\"",
    "test:server": "firebase emulators:exec --only firestore,auth --project demo-barbe-shop \"node --test tests/server-integration.test.mjs\""
  },
  "dependencies": {
    "firebase-admin": "14.5.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.0.0",
    "firebase-tools": "15.33.0"
  }
}
